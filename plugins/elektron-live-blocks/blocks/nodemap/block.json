{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elektron-live/nodemap",
	"version": "0.0.1",
	"title": "Node Map",
	"category": "elektron-live",
	"icon": "location-alt",
	"description": "Embeds the interactive world map of Elektron Net nodes.",
	"keywords": [
		"elektron",
		"blockchain",
		"live",
		"nodes"
	],
	"textdomain": "elektron-live-blocks",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"showUpdated": {
			"type": "boolean",
			"default": false
		},
		"height": {
			"type": "integer",
			"default": 520
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "elnb-editor",
	"style": "elnb-blocks"
}
